# Salin jadi .env lalu isi. File .env jangan pernah di-commit.
# gemini (default) atau ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Kosongkan untuk model default (gemini-3.1-flash-lite). Cadangan, gemini-3.8-flash
LLM_MODEL=

# ===== Knowledge =====
# full (default: seluruh file knowledge di prompt) atau rag (eksperimen: hanya potongan relevan)
KNOWLEDGE_MODE=full
# Mode rag saja. Jumlah potongan knowledge yang diambil per pesan (selain bagian pinned yang selalu ikut,
# lihat RAG_JUDUL_PINNED di prompt.md)
RAG_TOP_K=4
# Model embedding Gemini (pakai GEMINI_API_KEY yang sama). Ganti model = indeks rag/index.json dibangun ulang otomatis
EMBEDDING_MODEL=gemini-embedding-001
# Ambang cosine potongan teratas. Di bawah ini dianggap tidak ada data relevan (hanya bagian pinned yang ikut)
RAG_MIN_SKOR=0.55

# ===== WhatsApp =====
# Penyedia: meta (default, Cloud API langsung) | ycloud | 360dialog
# Variabel yang wajib diisi hanya blok penyedia yang dipilih.
WA_PROVIDER=meta

# --- WA_PROVIDER=meta ---
# WhatsApp Cloud API (developers.facebook.com, app Anda, WhatsApp > API Setup)
# Untuk tes, pakai nomor tes/cadangan, bukan nomor bisnis utama.
# Token permanen dari System User (Business Settings > Users > System users > Generate new token)
WA_TOKEN=
# Angka "Phone number ID" nomor yang dipakai bot (bukan nomor teleponnya)
WA_PHONE_NUMBER_ID=
# Angka "WhatsApp Business Account ID" (tidak dipakai server, hanya catatan)
WA_BUSINESS_ACCOUNT_ID=
# App secret dari App settings > Basic > App secret (untuk cek tanda tangan X-Hub-Signature-256)
WA_APP_SECRET=
# Kata sandi bebas buatan sendiri, isi sama persis di kolom "Verify token" saat set webhook di Meta
WA_VERIFY_TOKEN=

# --- WA_PROVIDER=ycloud (YCloud Console, mendukung coexistence dengan aplikasi WhatsApp Business) ---
# API key dari Developers > API Keys, dikirim di header X-API-Key
YCLOUD_API_KEY=
# Signing secret endpoint webhook (Developers > Webhook), untuk cek header YCloud-Signature
YCLOUD_WEBHOOK_SECRET=
# Nomor bisnis pengirim (field from), format E.164 dengan +, contoh +6281234567890
WA_BUSINESS_NUMBER=

# --- WA_PROVIDER=360dialog (360dialog Hub) ---
# API key nomor dari Hub, dikirim di header D360-API-KEY
D360_API_KEY=
# Token bebas buatan sendiri. Saat set webhook di Hub, isi header Authorization: Bearer <token ini>
D360_WEBHOOK_TOKEN=

# Port lokal server webhook (default 8000), sama dengan port di perintah cloudflared
WEBHOOK_PORT=8000
